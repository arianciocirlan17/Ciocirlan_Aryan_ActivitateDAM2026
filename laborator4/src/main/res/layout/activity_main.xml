<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tvRezultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/niciun_avion_nu_a_fost_adaugat"
        android:textSize="18sp"
        android:textAlignment="center"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnDeschideAdaugare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        android:text="@string/adauga_un_avion" />

    <Button
        android:id="@+id/btnDeschideLista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        android:text="@string/vezi_lista_avioane" />
</LinearLayout>